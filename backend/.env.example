# Copy to backend/.env and fill in. Never commit .env.

# Comma-separated origins allowed to call the API.
FRONTEND_ORIGIN=http://localhost:3000

# LLM (Phase 3): provider is one of anthropic | openai | gemini
LLM_PROVIDER=
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Serve recorded LLM responses instead of calling the provider (offline demo).
DEMO_MODE=false
