# Copy to backend/.env and fill in. Never commit .env.

# Comma-separated origins allowed to call the API.
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# AI program review. LLM_PROVIDER: empty = off (everyone gets the standard plan),
# openai = GPT via OPENAI_API_KEY, fake = scripted replies (tests, offline e2e).
LLM_PROVIDER=
LLM_MODEL=gpt-6.1-sol
# low | medium | high | xhigh | max (more = slower and more expensive)
LLM_EFFORT=medium
LLM_TIMEOUT_S=60
# Server-side only. Also set a monthly spend limit in the OpenAI dashboard.
OPENAI_API_KEY=

# Serve recorded LLM responses instead of calling the provider (offline demo).
DEMO_MODE=false
